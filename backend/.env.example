# Spotter Weather-Aware Truck Routing - Backend Environment Variables
DEBUG=True
SECRET_KEY=django-insecure-spotter-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Routing Provider API Key (OpenRouteService / Mapbox)
ROUTING_API_KEY=your_routing_api_key_here

# Weather Provider API Key (Open-Meteo free tier requires no key; custom providers if needed)
WEATHER_API_KEY=
